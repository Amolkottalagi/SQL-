# Copy to .env (or let `python -m backend.setup_db` write it for you). Real environment variables win over this file.

# App database (users, chats, usage, payments)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sqlllm_app
DB_PASSWORD=change_me
DB_NAME=app_db

# Database the AI answers questions about. Use a SELECT-only account.
TARGET_DB_USER=llm_reader
TARGET_DB_PASSWORD=change_me
TARGET_DB_NAME=shop_db

# AI: auto (Gemini if GEMINI_API_KEY is set, else the offline demo), gemini, or demo
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 when served over HTTPS
COOKIE_SECURE=0

# Password reset links: "console" prints to the server log; "response" returns them in the API (local dev ONLY)
RESET_LINK_MODE=console

# Payments: leave empty for the demo gateway (no real money)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional tuning
# MAX_ROWS=500
# QUERY_TIMEOUT_SEC=5
# MAX_SQL_RETRIES=1
# SCHEMA_SAMPLE_ROWS=3
# SESSION_HOURS=12
# HOST=127.0.0.1
# PORT=8000
